      <mass value="${chassis_mass}"/>
      <inertia ixx="${chassis_mass * (0.601**2 + 0.580**2) / 12}" ixy="0" ixz="0"
               iyy="${chassis_mass * (1.604**2 + 0.580**2) / 12}" iyz="0"
               izz="${chassis_mass * (1.604**2 + 0.601**2) / 12}"/>
    </inertial>
